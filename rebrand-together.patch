+package com.lastwave.app.ui.together
+
+import android.content.Context
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.lastwave.app.BuildConfig
+import com.lastwave.app.data.generate.GeneratedTrack
+import com.lastwave.app.data.generate.youtubeVideoIdOrNull
+import com.lastwave.app.data.playlist.PlaylistRepository
+import com.lastwave.app.data.playlist.SpotifyPlaylistImporter
+import com.lastwave.app.playback.MusicPlayer
+import com.lastwave.app.playback.PlayableTrack
+import dagger.hilt.android.lifecycle.HiltViewModel
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import java.security.SecureRandom
+import java.util.UUID
+import javax.inject.Inject
+
+data class TogetherUiState(
+    val configured: Boolean = false,
+    val username: String = "",
+    val roomCodeInput: String = "",
+    val inRoom: Boolean = false,
+    val roomCode: String = "",
+    val isHost: Boolean = false,
+    val connection: TogetherConnection = TogetherConnection.Disconnected,
+    val members: List<TogetherMember> = emptyList(),
+    val roomTrack: TogetherRoomState? = null,
+    val roomPlaylist: List<TogetherPlaylistItem> = emptyList(),
+    val showImportDialog: Boolean = false,
+    val importDialogPlaylists: List<ImportablePlaylist> = emptyList(),
+    val spotifyLink: String = "",
+    val importingSpotify: Boolean = false,
+    val lastError: String? = null,
+    val autoSync: Boolean = true,
+    val error: String? = null,
+    val copied: Boolean = false,
+)
+
+/** One of the user's own saved playlists, offered for import into the room. */
+data class ImportablePlaylist(
+    val id: Long,
+    val title: String,
+    val trackCount: Int,
+)
+private const val PREFS = "together_prefs"
+
+/** Title of the persistent playlist the room playlist auto-saves into. */
+private const val TOGETHER_SAVED_TITLE = "Together"
+private const val KEY_USERNAME = "username"
+private const val KEY_AUTO_SYNC = "auto_sync"
+private const val KEY_SELF_ID = "self_id"
+
+/** Drift above this is corrected with a seek (keeps both players aligned). */
+private const val DRIFT_TOLERANCE_MS = 600L
+
+/** Pause confirm window: a pause must still hold after this long before it
+ *  is sent to the room. Buffering stalls recover inside the window, so a
+ *  stall is never mistaken for a real pause. */
+private const val PAUSE_CONFIRM_DELAY_MS = 1_200L
+
+/** Poll step while a pause waits out a buffering stall. */
+private const val PAUSE_CONFIRM_POLL_MS = 300L
+
+/** Longest a pause waits for a stall to clear. After this the pause is
+ *  dropped silently: a player still stalled this long was never paused by
+ *  the user, so the room must keep playing. */
+private const val PAUSE_CONFIRM_MAX_WAIT_MS = 10_000L
+
+/** The only connection problem text the UI ever shows: no hostnames, no
+ *  URLs, no technical detail. */
+private const val FRIENDLY_CONNECTION_ISSUE =
+    "Connection issue. Check your internet and tap Reconnect."
+
+/**
+ * Owns the Together room: creating/joining, broadcasting each member's
+ * playback, applying remote state, drift correction and reconnects.
+ *
+ * Sync is bidirectional: any member can control playback and the rest
+ * follow. Echo suppression ([statesMatch]) plus the broadcast gates in
+ * [broadcastCurrentState] stop applied states and local failures from
+ * bouncing back and forth. The shared [MusicPlayer] is reused — joining
+ * a room replaces local playback with the room's track, exactly like
+ * tapping any other track in the app.
+ */
+@HiltViewModel
+class TogetherViewModel @Inject constructor(
+    private val musicPlayer: MusicPlayer,
+    private val playlistRepository: PlaylistRepository,
+    private val spotifyPlaylistImporter: SpotifyPlaylistImporter,
+    @ApplicationContext private val context: Context,
+) : ViewModel() {
+
+    private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val engine = TogetherSyncEngine()
+
+    private val selfId: String = prefs.getString(KEY_SELF_ID, null) ?: UUID.randomUUID().toString().also {
+        prefs.edit().putString(KEY_SELF_ID, it).apply()
+    }
+
+    private val _uiState = MutableStateFlow(
+        TogetherUiState(
+            configured = BuildConfig.SUPABASE_URL.isNotBlank() && BuildConfig.SUPABASE_ANON_KEY.isNotBlank(),
+            username = prefs.getString(KEY_USERNAME, "") ?: "",
+            autoSync = prefs.getBoolean(KEY_AUTO_SYNC, true),
+        )
+    )
+    val uiState: StateFlow<TogetherUiState> = _uiState.asStateFlow()
+
+    private var pendingRoomState: TogetherRoomState? = null
+    private var pendingReceivedAtMs: Long = 0L
+    private var pendingSeekSetAtMs: Long = 0L
+    private var pendingPauseJob: Job? = null
+    private var lastAppliedState: TogetherRoomState? = null
+    private var lastBroadcastState: TogetherRoomState? = null
+    private var playlistUpdatedAtMs: Long = 0L
+    private var suppressBroadcastUntilMs: Long = 0L
+    private var lastHostPositionMs: Long = 0L
+    private var lastHostEmittedAtMs: Long = 0L
+    private var lastBroadcastVideoId: String? = null
+    private var lastBroadcastPlaying: Boolean? = null
+    private var heartbeatStarted = false
+
+    init {
+        engine.onConnection = { connection ->
+            _uiState.update {
+                it.copy(
+                    connection = connection,
+                    lastError = if (connection is TogetherConnection.Connected) null else it.lastError,
+                )
+            }
+            if (connection is TogetherConnection.Connected) {
+                val state = _uiState.value
+                engine.sendHello(TogetherMember(selfId, state.username, state.isHost))
+                engine.sendStateRequest(TogetherMember(selfId, state.username, state.isHost))
+            }
+        }
+        engine.onError = { message ->
+            // Never surface raw engine text: it can contain backend
+            // hostnames/URLs and technical detail the user must not see.
+            _uiState.update { it.copy(lastError = FRIENDLY_CONNECTION_ISSUE) }
+        }
+        engine.onRoomState = { roomState -> onRoomStateReceived(roomState) }
+        engine.onMemberHello = { member ->
+            _uiState.update { state ->
+                val without = state.members.filterNot { it.id == member.id }
+                state.copy(members = (without + member).sortedBy { !it.isHost })
+            }
+            // A newcomer (or a reconnected member) gets the current room
+            // playlist so late joiners are not stuck with an empty list.
+            val state = _uiState.value
+            if (state.inRoom && state.roomPlaylist.isNotEmpty()) broadcastPlaylist()
+        }
+        engine.onMemberBye = { member ->
+            // Any member may leave; the room keeps working for everyone else.
+            _uiState.update { state ->
+                state.copy(members = state.members.filterNot { it.id == member.id })
+            }
+        }
+        engine.onStateRequested = { _ ->
+            // Anyone in the room can answer a state request with a fresh snapshot.
+            if (_uiState.value.inRoom) broadcastCurrentState()
+        }
+        engine.onPlaylist = { playlist -> onPlaylistReceived(playlist) }
+        observePlayer()
+        startHeartbeat()
+    }
+
+    fun onUsernameChange(value: String) {
+        _uiState.update { it.copy(username = value, error = null) }
+    }
+
+    fun onRoomCodeInputChange(value: String) {
+        _uiState.update {
+            it.copy(
+                roomCodeInput = value.filter { ch -> ch.isDigit() }.take(6),
+                error = null,
+            )
+        }
+    }
+
+    fun onAutoSyncChange(enabled: Boolean) {
+        prefs.edit().putBoolean(KEY_AUTO_SYNC, enabled).apply()
+        _uiState.update { it.copy(autoSync = enabled) }
+    }
+
+    fun createRoom() {
+        val username = _uiState.value.username.trim()
+        if (!validUsername(username)) {
+            _uiState.update { it.copy(error = "Please enter a name (2–20 characters).") }
+            return
+        }
+        if (!_uiState.value.configured) {
+            _uiState.update { it.copy(error = "Together is not set up yet on this build.") }
+            return
+        }
+        saveUsername(username)
+        val code = generateRoomCode()
+        joinEngine(code, isHost = true)
+        _uiState.update {
+            it.copy(
+                inRoom = true,
+                roomCode = code,
+                isHost = true,
+                members = listOf(TogetherMember(selfId, username, true)),
+                lastError = null,
+                error = null,
+            )
+        }
+        broadcastCurrentState()
+    }
+
+    fun joinRoom() {
+        val username = _uiState.value.username.trim()
+        if (!validUsername(username)) {
+            _uiState.update { it.copy(error = "Please enter a name (2–20 characters).") }
+            return
+        }
+        if (!_uiState.value.configured) {
+            _uiState.update { it.copy(error = "Together is not set up yet on this build.") }
+            return
+        }
+        val code = _uiState.value.roomCodeInput.trim()
+        if (code.length != 6 || !code.all { it.isDigit() }) {
+            _uiState.update { it.copy(error = "Enter the 6-digit room code.") }
+            return
+        }
+        saveUsername(username)
+        joinEngine(code, isHost = false)
+        _uiState.update {
+            it.copy(
+                inRoom = true,
+                roomCode = code,
+                isHost = false,
+                members = listOf(TogetherMember(selfId, username, false)),
+                lastError = null,
+                error = null,
+            )
+        }
+    }
+
+    fun leaveRoom() {
+        val state = _uiState.value
+        if (state.inRoom) {
+            engine.sendBye(TogetherMember(selfId, state.username, state.isHost))
+        }
+        engine.disconnect()
+        _uiState.update {
+            it.copy(
+                inRoom = false,
+                roomCode = "",
+                isHost = false,
+                members = emptyList(),
+                roomTrack = null,
+                roomPlaylist = emptyList(),
+                lastError = null,
+                error = null,
+            )
+        }
+        playlistUpdatedAtMs = 0L
+        suppressBroadcastUntilMs = 0L
+        pendingPauseJob?.cancel()
+        pendingPauseJob = null
+        pendingRoomState = null
+    }
+
+    /** Room playlist: shared queue keyed by the room code only (no room
+     *  name). Anyone in the room can add the song that is playing, play a
+     *  queued song for everyone, or remove/clear entries. */
+    fun addCurrentSongToPlaylist() {
+        val state = _uiState.value
+        if (!state.inRoom) return
+        val current = musicPlayer.state.value.current
+        if (current?.videoId == null) {
+            _uiState.update { it.copy(error = "Nothing playing to add") }
+            return
+        }
+        if (state.roomPlaylist.any { it.videoId == current.videoId }) {
+            _uiState.update { it.copy(error = "Already in playlist") }
+            return
+        }
+        val item = TogetherPlaylistItem(
+            videoId = current.videoId,
+            title = current.title,
+            artist = current.artist,
+            artworkUrl = current.artworkUrl,
+            durationMs = current.durationMs ?: 0L,
+            addedBy = state.username,
+        )
+        updatePlaylist(state.roomPlaylist + item, error = null)
+    }
+
+    fun removeFromRoomPlaylist(videoId: String) {
+        val state = _uiState.value
+        if (!state.inRoom) return
+        updatePlaylist(state.roomPlaylist.filterNot { it.videoId == videoId }, error = null)
+    }
+
+    fun clearRoomPlaylist() {
+        val state = _uiState.value
+        if (!state.inRoom) return
+        updatePlaylist(emptyList(), error = null)
+    }
+
+    fun playRoomPlaylistItem(videoId: String) {
+        val item = _uiState.value.roomPlaylist.firstOrNull { it.videoId == videoId } ?: return
+        viewModelScope.launch(Dispatchers.Main) {
+            musicPlayer.play(
+                PlayableTrack(
+                    title = item.title,
+                    artist = item.artist,
+                    artworkUrl = item.artworkUrl,
+                    videoId = item.videoId,
+                    durationMs = item.durationMs.takeIf { it > 0 },
+                ),
+                sourceLabel = "Together",
+                startRadio = false,
+            )
+        }
+    }
+
+    private fun updatePlaylist(items: List<TogetherPlaylistItem>, error: String?) {
+        val now = System.currentTimeMillis()
+        playlistUpdatedAtMs = now
+        _uiState.update { it.copy(roomPlaylist = items, error = error) }
+        broadcastPlaylist()
+        autoSaveRoomPlaylist(items)
+    }
+
+    /** Re-send the current playlist without changing its timestamp. */
+    private fun broadcastPlaylist() {
+        val state = _uiState.value
+        if (!state.inRoom) return
+        engine.sendPlaylist(
+            TogetherPlaylistState(
+                items = state.roomPlaylist,
+                updatedAtMs = playlistUpdatedAtMs,
+                senderId = selfId,
+            )
+        )
+    }
+
+    private fun onPlaylistReceived(playlist: TogetherPlaylistState) {
+        if (playlist.senderId == selfId) return
+        if (!_uiState.value.inRoom) return
+        // Last-write-wins: ignore stale snapshots.
+        if (playlist.updatedAtMs < playlistUpdatedAtMs) return
+        playlistUpdatedAtMs = playlist.updatedAtMs
+        _uiState.update { it.copy(roomPlaylist = playlist.items) }
+        autoSaveRoomPlaylist(playlist.items)
+    }
+
+    /**
+     * Auto-save: whatever is in the room playlist is mirrored into the
+     * user's own persistent "Together" playlist, so the songs survive
+     * after the room ends. Runs on IO and never breaks the room if
+     * storage fails — the room is the source of truth.
+     */
+    private var togetherSavedPlaylistId: Long? = null
+
+    private fun autoSaveRoomPlaylist(items: List<TogetherPlaylistItem>) {
+        viewModelScope.launch(Dispatchers.IO) {
+            runCatching {
+                val id = togetherSavedPlaylistId
+                    ?: playlistRepository.findByTitle(TOGETHER_SAVED_TITLE, "custom")?.id
+                    ?: playlistRepository.createCustom(TOGETHER_SAVED_TITLE).id
+                togetherSavedPlaylistId = id
+                playlistRepository.replaceTracksForSync(
+                    id,
+                    items.map { it.toGeneratedTrack() },
+                )
+            }
+        }
+    }
+
+    /** Import dialog: list the user's own saved playlists. */
+    fun openImportDialog() {
+        viewModelScope.launch(Dispatchers.IO) {
+            val playlists = runCatching {
+                playlistRepository.getAll()
+                    .filter { it.mode == "custom" && it.tracks.isNotEmpty() }
+                    .map { ImportablePlaylist(it.id, it.title, it.tracks.size) }
+            }.getOrDefault(emptyList())
+            _uiState.update {
+                it.copy(showImportDialog = true, importDialogPlaylists = playlists, error = null)
+            }
+        }
+    }
+
+    fun closeImportDialog() {
+        _uiState.update { it.copy(showImportDialog = false) }
+    }
+
+    fun onSpotifyLinkChange(value: String) {
+        _uiState.update { it.copy(spotifyLink = value) }
+    }
+
+    /** Import one of the user's own playlists into the room. */
+    fun importPlaylistIntoRoom(id: Long) {
+        viewModelScope.launch(Dispatchers.IO) {
+            val saved = runCatching { playlistRepository.getById(id) }.getOrNull()
+            val items = saved?.tracks.orEmpty().mapNotNull { it.toRoomItem(_uiState.value.username) }
+            if (items.isEmpty()) {
+                _uiState.update { it.copy(error = "No playable tracks in this playlist") }
+                return@launch
+            }
+            mergeIntoRoomPlaylist(items)
+            _uiState.update { it.copy(showImportDialog = false) }
+        }
+    }
+
+    /** Import a public Spotify playlist link into the room. No Spotify
+     *  login needed: the app reads the public playlist page and matches
+     *  its tracks to playable songs. */
+    fun importSpotifyIntoRoom() {
+        val link = _uiState.value.spotifyLink.trim()
+        if (link.isEmpty()) {
+            _uiState.update { it.copy(error = "Paste a Spotify playlist link") }
+            return
+        }
+        _uiState.update { it.copy(importingSpotify = true, error = null) }
+        viewModelScope.launch(Dispatchers.IO) {
+            runCatching {
+                val result = spotifyPlaylistImporter.fetchAndMatch(link)
+                val items = result.tracks.mapNotNull { it.toRoomItem(_uiState.value.username) }
+                if (items.isEmpty()) {
+                    _uiState.update {
+                        it.copy(
+                            importingSpotify = false,
+                            error = "No tracks from that playlist could be matched. " +
+                                "Make sure the playlist is public.",
+                        )
+                    }
+                    return@runCatching
+                }
+                mergeIntoRoomPlaylist(items)
+                _uiState.update { it.copy(importingSpotify = false, showImportDialog = false) }
+            }.onFailure {
+                _uiState.update {
+                    it.copy(
+                        importingSpotify = false,
+                        error = "Could not read that playlist. Check the link and try again.",
+                    )
+                }
+            }
+        }
+    }
+
+    /** Merge new items into the room playlist (no duplicates), then
+     *  broadcast + auto-save through the single update path. */
+    private fun mergeIntoRoomPlaylist(newItems: List<TogetherPlaylistItem>) {
+        val state = _uiState.value
+        if (!state.inRoom) return
+        val existing = state.roomPlaylist.map { it.videoId }.toSet()
+        val merged = state.roomPlaylist + newItems.filterNot { it.videoId in existing }
+        if (merged.size == state.roomPlaylist.size) {
+            _uiState.update { it.copy(error = "Already in playlist") }
+            return
+        }
+        updatePlaylist(merged, error = null)
+    }
+
+    private fun GeneratedTrack.toRoomItem(addedBy: String): TogetherPlaylistItem? {
+        val videoId = youtubeVideoIdOrNull() ?: return null
+        return TogetherPlaylistItem(
+            videoId = videoId,
+            title = name,
+            artist = artist,
+            artworkUrl = artworkUrl,
+            durationMs = 0L,
+            addedBy = addedBy,
+        )
+    }
+
+    private fun TogetherPlaylistItem.toGeneratedTrack(): GeneratedTrack =
+        GeneratedTrack(
+            name = title,
+            artist = artist,
+            artworkUrl = artworkUrl,
+            url = "https://music.youtube.com/watch?v=$videoId",
+        )
+
+    fun reconnect() {
+        engine.reconnect()
+    }
+
+    fun onCopied() {
+        _uiState.update { it.copy(copied = true) }
+    }
+
+    fun onCopiedConsumed() {
+        _uiState.update { it.copy(copied = false) }
+    }
+
+    private fun joinEngine(code: String, isHost: Boolean) {
+        _uiState.update { it.copy(isHost = isHost) }
+        engine.connect(BuildConfig.SUPABASE_URL, BuildConfig.SUPABASE_ANON_KEY, code)
+    }
+
+    private fun validUsername(name: String): Boolean = name.length in 2..20
+
+    private fun saveUsername(username: String) {
+        prefs.edit().putString(KEY_USERNAME, username).apply()
+    }
+
+    private fun generateRoomCode(): String {
+        // Digits only, so the code is easy to read out and type.
+        val alphabet = "0123456789"
+        val random = SecureRandom()
+        return buildString {
+            repeat(6) { append(alphabet[random.nextInt(alphabet.length)]) }
+        }
+    }
+
+    /** Every member watches the shared player and broadcasts each change,
+     *  so playback control works from EITHER device. Echo suppression
+     *  (see [statesMatch]) stops applied remote states from bouncing
+     *  back and forth forever. */
+    private fun observePlayer() {
+        viewModelScope.launch {
+            musicPlayer.state.collect { player ->
+                val state = _uiState.value
+                // Apply a pending seek once the room track is loaded. The
+                // seek target is computed at apply time from the moment
+                // the state arrived, so a slow stream resolve does not
+                // leave the seek seconds behind.
+                val pending = pendingRoomState
+                if (pending != null) {
+                    if (player.current?.videoId == pending.trackVideoId) {
+                        val seekTo = expectedPosition(pending, pendingReceivedAtMs)
+                        // Hold broadcasts until the catch-up seek lands,
+                        // otherwise this device broadcasts "position ~0"
+                        // and drags the other device back to the start.
+                        suppressBroadcastUntilMs = System.currentTimeMillis() + 2_000
+                        viewModelScope.launch(Dispatchers.Main) {
+                            musicPlayer.seekTo(seekTo)
+                            pendingRoomState = null
+                        }
+                    } else if (System.currentTimeMillis() - pendingSeekSetAtMs > 10_000) {
+                        pendingRoomState = null
+                    }
+                }
+                if (!state.inRoom) return@collect
+                val videoId = player.current?.videoId
+                if (videoId != lastBroadcastVideoId) {
+                    pendingPauseJob?.cancel()
+                    lastBroadcastVideoId = videoId
+                    lastBroadcastPlaying = player.isPlaying
+                    broadcastCurrentState(playerPositionMs = player.positionMs)
+                } else if (player.isPlaying != lastBroadcastPlaying) {
+                    if (player.isPlaying) {
+                        // Resumed: cancel any pending pause, sync at once.
+                        pendingPauseJob?.cancel()
+                        lastBroadcastPlaying = true
+                        broadcastCurrentState(playerPositionMs = player.positionMs)
+                    } else {
+                        // Paused — but not confirmed yet. Media3 reports
+                        // isPlaying=false while the player is merely
+                        // buffering (network stall). Broadcasting that
+                        // would pause the other device for no reason, so
+                        // wait: only a pause that still holds after the
+                        // window, and is not buffering, reaches the room.
+                        // A pause pressed DURING a stall must not be lost:
+                        // pausing clears buffering, so the poll below sees
+                        // it and sends it once the stall flag drops.
+                        lastBroadcastPlaying = false
+                        pendingPauseJob?.cancel()
+                        pendingPauseJob = viewModelScope.launch {
+                            delay(PAUSE_CONFIRM_DELAY_MS)
+                            var waitedMs = 0L
+                            while (waitedMs <= PAUSE_CONFIRM_MAX_WAIT_MS) {
+                                val current = musicPlayer.state.value
+                                if (current.isPlaying) return@launch // resumed: not a pause
+                                if (!current.isBuffering) {
+                                    broadcastCurrentState()
+                                    return@launch
+                                }
+                                delay(PAUSE_CONFIRM_POLL_MS)
+                                waitedMs += PAUSE_CONFIRM_POLL_MS
+                            }
+                            // Still stalled after the max wait: not a user
+                            // pause, so send nothing — the room keeps playing.
+                        }
+                    }
+                } else {
+                    // Seek detection: position jumped far beyond natural progress.
+                    val now = System.currentTimeMillis()
+                    val delta = player.positionMs - lastHostPositionMs
+                    val elapsed = now - lastHostEmittedAtMs
+                    if (delta < -400 || delta > elapsed + 1_500) {
+                        broadcastCurrentState(playerPositionMs = player.positionMs)
+                    }
+                }
+                lastHostPositionMs = player.positionMs
+                lastHostEmittedAtMs = System.currentTimeMillis()
+            }
+        }
+    }
+
+    /** Heartbeat keeps all members aligned even without other changes. */
+    private fun startHeartbeat() {
+        if (heartbeatStarted) return
+        heartbeatStarted = true
+        viewModelScope.launch {
+            while (true) {
+                kotlinx.coroutines.delay(3_000)
+                val state = _uiState.value
+                if (state.inRoom && state.connection is TogetherConnection.Connected) {
+                    broadcastCurrentState()
+                }
+            }
+        }
+    }
+
+    private fun broadcastCurrentState(playerPositionMs: Long? = null) {
+        val state = _uiState.value
+        if (!state.inRoom) return
+        // Gates: a device must never drag the room down with its own
+        // local trouble — a failed stream, a watch-only member, or a
+        // still-catching-up seek all stay local until they are real.
+        if (!state.autoSync) return
+        if (System.currentTimeMillis() < suppressBroadcastUntilMs) return
+        if (pendingRoomState != null) return
+        val player = musicPlayer.state.value
+        if (player.error != null) return
+        // A stalled player (not playing, still buffering) is not paused:
+        // its state must never reach the room, or the other device would
+        // pause for a network stall. This also closes the heartbeat path,
+        // which otherwise broadcast stall states every 3 seconds.
+        if (!player.isPlaying && player.isBuffering) return
+        val roomState = TogetherRoomState(
+            trackVideoId = player.current?.videoId,
+            title = player.current?.title,
+            artist = player.current?.artist,
+            artworkUrl = player.current?.artworkUrl,
+            durationMs = player.durationMs,
+            positionMs = playerPositionMs ?: player.positionMs,
+            playing = player.isPlaying,
+            updatedAtMs = System.currentTimeMillis(),
+            senderId = selfId,
+            senderName = state.username,
+            isHost = state.isHost,
+        )
+        // Echo suppression: this change came from a remote state we just
+        // applied, so re-broadcasting it would ping-pong forever.
+        if (statesMatch(roomState, lastAppliedState)) return
+        _uiState.update { it.copy(roomTrack = roomState) }
+        lastBroadcastState = roomState
+        engine.sendState(roomState)
+    }
+
+    /** Two snapshots count as the same moment when track + play state match
+     *  and positions are within 2 seconds of each other. */
+    private fun statesMatch(a: TogetherRoomState, b: TogetherRoomState?): Boolean {
+        if (b == null) return false
+        return a.trackVideoId == b.trackVideoId &&
+            a.playing == b.playing &&
+            kotlin.math.abs(a.positionMs - b.positionMs) < 2_000
+    }
+
+    /** Joiner: apply the host's snapshot to the shared player. */
+    private fun onRoomStateReceived(roomState: TogetherRoomState) {
+        // The moment this state arrived, on THIS device's clock. Position
+        // math uses it — never the sender's clock, so phones whose clocks
+        // disagree by seconds still land on the same timeline.
+        val receivedAtMs = System.currentTimeMillis()
+        if (roomState.senderId == selfId) return
+        _uiState.update { it.copy(roomTrack = roomState) }
+        val state = _uiState.value
+        if (!state.inRoom) return
+        // Echo suppression: this is our own state bounced back through
+        // the other device after it applied it.
+        if (statesMatch(roomState, lastBroadcastState)) return
+        // Dedupe: this exact moment was already applied (duplicate
+        // delivery, or two members answering one state request).
+        if (statesMatch(roomState, lastAppliedState)) return
+        if (!state.autoSync) return
+        lastAppliedState = roomState
+        val videoId = roomState.trackVideoId ?: return
+        viewModelScope.launch(Dispatchers.Main) {
+            val local = musicPlayer.state.value
+            if (local.current?.videoId != videoId) {
+                val track = PlayableTrack(
+                    title = roomState.title ?: "Unknown",
+                    artist = roomState.artist ?: "Unknown",
+                    artworkUrl = roomState.artworkUrl,
+                    videoId = videoId,
+                    durationMs = roomState.durationMs.takeIf { it > 0 },
+                )
+                pendingRoomState = roomState
+                pendingReceivedAtMs = receivedAtMs
+                pendingSeekSetAtMs = System.currentTimeMillis()
+                suppressBroadcastUntilMs = System.currentTimeMillis() + 2_000
+                musicPlayer.play(track, sourceLabel = "Together", startRadio = false)
+                if (roomState.playing) musicPlayer.resume() else musicPlayer.pause()
+            } else {
+                val expected = expectedPosition(roomState, receivedAtMs)
+                if (kotlin.math.abs(local.positionMs - expected) > DRIFT_TOLERANCE_MS) {
+                    musicPlayer.seekTo(expected)
+                }
+                if (roomState.playing != local.isPlaying) {
+                    if (roomState.playing) musicPlayer.resume() else musicPlayer.pause()
+                }
+            }
+        }
+    }
+
+    private fun expectedPosition(roomState: TogetherRoomState, receivedAtMs: Long): Long {
+        if (!roomState.playing) return roomState.positionMs
+        val elapsed = System.currentTimeMillis() - receivedAtMs
+        return (roomState.positionMs + elapsed).coerceAtLeast(0L)
+    }
+
+    override fun onCleared() {
+        super.onCleared()
+        pendingPauseJob?.cancel()
+        engine.disconnect()
+        engine.release()
+    }
+}

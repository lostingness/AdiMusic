--- /dev/null
+++ b/app/src/main/java/com/lastwave/app/ui/together/RoomRegistry.kt
@@ -0,0 +1,167 @@
+package com.lastwave.app.ui.together
+
+import com.lastwave.app.BuildConfig
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import java.util.concurrent.TimeUnit
+
+/**
+ * Room registry: the single source of truth for which room codes exist.
+ *
+ * Rooms are Realtime channels, and a channel comes into existence the
+ * moment anyone joins it — so without a registry ANY 6-digit code
+ * "joined" successfully, including codes nobody ever created. The
+ * registry fixes that: creating a room writes a row, joining checks it.
+ *
+ * Storage: one Supabase Postgres table (`together_rooms`, see
+ * `supabase-rooms.sql` — run once in the Supabase SQL editor). Rows hold
+ * only the code, the host's display name, a creator id and timestamps —
+ * no chat, no songs, nothing sensitive. Chat is never stored anywhere:
+ * it travels over the Realtime channel and lives only in members'
+ * memory, so it disappears when they leave.
+ *
+ * A row is valid for exactly 24 hours ([ROOM_VALIDITY_MS]); expired rows
+ * are ignored by every check and pruned on the next create. If the
+ * table does not exist yet (SQL not run) or the network fails, every
+ * call reports [RoomCheck.Unknown] / [RoomRegister.Unavailable] and the
+ * caller falls back to a presence probe instead of bricking Together.
+ */
+sealed interface RoomCheck {
+    /** A live, unexpired room uses this code. */
+    data object Live : RoomCheck
+
+    /** The registry is reachable and says this code has no live room. */
+    data object NotFound : RoomCheck
+
+    /** Registry unreachable — caller must fall back to a presence probe. */
+    data object Unknown : RoomCheck
+}
+
+sealed interface RoomRegister {
+    data object Registered : RoomRegister
+
+    /** A live room already uses this code — caller must pick another. */
+    data object Conflict : RoomRegister
+
+    /** Registry unreachable — caller proceeds in presence-only mode. */
+    data object Unavailable : RoomRegister
+}
+
+class RoomRegistry {
+
+    private val client = OkHttpClient.Builder()
+        .callTimeout(8, TimeUnit.SECONDS)
+        .build()
+
+    private val jsonMediaType = "application/json".toMediaType()
+
+    private fun tableUrl(): String =
+        BuildConfig.SUPABASE_URL.trimEnd('/') + "/rest/v1/together_rooms"
+
+    private fun isoUtc(millis: Long): String {
+        val format = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US)
+        format.timeZone = TimeZone.getTimeZone("UTC")
+        return format.format(Date(millis))
+    }
+
+    private fun authed(url: String, method: String, body: String? = null): Request {
+        val builder = Request.Builder()
+            .url(url)
+            .header("apikey", BuildConfig.SUPABASE_ANON_KEY)
+            .header("Authorization", "Bearer ${BuildConfig.SUPABASE_ANON_KEY}")
+        when (method) {
+            "GET" -> builder.get()
+            "POST" -> builder
+                .header("Prefer", "return=minimal")
+                .post((body ?: "").toRequestBody(jsonMediaType))
+            "DELETE" -> builder.delete()
+        }
+        return builder.build()
+    }
+
+    /** True when the registry holds a live (unexpired) row for [code]. */
+    suspend fun isRoomLive(code: String): RoomCheck = withContext(Dispatchers.IO) {
+        try {
+            val url = tableUrl() +
+                "?code=eq.$code&expires_at=gt.${isoUtc(System.currentTimeMillis())}" +
+                "&select=code&limit=1"
+            client.newCall(authed(url, "GET")).execute().use { response ->
+                if (!response.isSuccessful) return@withContext RoomCheck.Unknown
+                val body = response.body?.string().orEmpty().trim()
+                // PostgREST returns "[]" for no rows, "[{...}]" for a hit.
+                if (body.length > 2) RoomCheck.Live else RoomCheck.NotFound
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            RoomCheck.Unknown
+        }
+    }
+
+    /** Register a room for 24 hours. Prunes expired rows first so their
+     *  codes become reusable. */
+    suspend fun registerRoom(
+        code: String,
+        hostName: String,
+        creatorId: String,
+    ): RoomRegister = withContext(Dispatchers.IO) {
+        try {
+            cleanupExpired()
+            val expiresAt = isoUtc(System.currentTimeMillis() + ROOM_VALIDITY_MS)
+            val payload = "{" +
+                "\"code\":${jsonString(code)}," +
+                "\"host_name\":${jsonString(hostName)}," +
+                "\"creator_id\":${jsonString(creatorId)}," +
+                "\"expires_at\":${jsonString(expiresAt)}" +
+                "}"
+            client.newCall(authed(tableUrl(), "POST", payload)).execute().use { response ->
+                when (response.code) {
+                    200, 201, 204 -> RoomRegister.Registered
+                    409 -> RoomRegister.Conflict
+                    else -> RoomRegister.Unavailable
+                }
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            RoomRegister.Unavailable
+        }
+    }
+
+    /** Best-effort delete of expired rows (allowed by RLS). Failures are
+     *  ignored: expired rows are already invisible to every check. */
+    private suspend fun cleanupExpired() {
+        try {
+            val url = tableUrl() + "?expires_at=lt.${isoUtc(System.currentTimeMillis())}"
+            client.newCall(authed(url, "DELETE")).execute().use { }
+        } catch (e: Exception) {
+            // Ignore — expiry is enforced by the checks, not by cleanup.
+        }
+    }
+
+    /** Minimal JSON string escaping (host names are user input). */
+    private fun jsonString(value: String): String {
+        val escaped = buildString {
+            for (ch in value) {
+                when (ch) {
+                    '"' -> append("\\\"")
+                    '\\' -> append("\\\\")
+                    '\n' -> append("\\n")
+                    '\r' -> append("\\r")
+                    '\t' -> append("\\t")
+                    else -> if (ch < ' ') append("\\u%04x".format(ch.code)) else append(ch)
+                }
+            }
+        }
+        return "\"$escaped\""
+    }
+}

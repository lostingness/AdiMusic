+    fun createRoom() {
+        val username = _uiState.value.username.trim()
+        if (!validUsername(username)) {
+            _uiState.update { it.copy(error = "Please enter a name (2–20 characters).") }
+            return
+        }
+        if (!_uiState.value.configured) {
+            _uiState.update { it.copy(error = "Together is not set up yet on this build.") }
+            return
+        }
+        if (roomActionInFlight) return
+        roomActionInFlight = true
+        saveUsername(username)
+        // Register first (so a friend joining immediately finds the room),
+        // then join the channel. A code already used by a live room is
+        // rejected by the registry — a fresh code is tried instead.
+        viewModelScope.launch(Dispatchers.IO) {
+            var code: String? = null
+            var attempts = 0
+            while (code == null && attempts < 3) {
+                attempts++
+                val candidate = generateRoomCode()
+                when (roomRegistry.registerRoom(candidate, username, selfId)) {
+                    RoomRegister.Registered, RoomRegister.Unavailable -> code = candidate
+                    RoomRegister.Conflict -> { /* try another code */ }
+                }
+            }
+            val finalCode = code
+            if (finalCode == null) {
+                roomActionInFlight = false
+                _uiState.update { it.copy(error = "Could not create a room. Try again.") }
+                return@launch
+            }
+            enterRoom(finalCode, isHost = true)
+        }
+    }
+
+    fun joinRoom() {
+        val username = _uiState.value.username.trim()
+        if (!validUsername(username)) {
+            _uiState.update { it.copy(error = "Please enter a name (2–20 characters).") }
+            return
+        }
+        if (!_uiState.value.configured) {
+            _uiState.update { it.copy(error = "Together is not set up yet on this build.") }
+            return
+        }
+        val code = _uiState.value.roomCodeInput.trim()
+        if (code.length != 6 || !code.all { it.isDigit() }) {
+            _uiState.update { it.copy(error = "Enter the 6-digit room code.") }
+            return
+        }
+        if (roomActionInFlight) return
+        roomActionInFlight = true
+        saveUsername(username)
+        viewModelScope.launch(Dispatchers.IO) {
+            when (roomRegistry.isRoomLive(code)) {
+                RoomCheck.Live -> enterRoom(code, isHost = false)
+                RoomCheck.NotFound -> {
+                    roomActionInFlight = false
+                    _uiState.update {
+                        it.copy(error = "Room not found. Check the code and try again.")
+                    }
+                }
+                RoomCheck.Unknown -> {
+                    // Registry unreachable (table not set up yet?): fall back
+                    // to a presence probe — join only if a real member
+                    // answers, so fake codes still cannot join.
+                    enterRoom(code, isHost = false)
+                    startProbe()
+                }
+            }
+        }
+    }
+
+    /** Shared entry path for create + join: connect, show the room,
+     *  start the presence loop. */
+    private fun enterRoom(code: String, isHost: Boolean) {
+        joinEngine(code, isHost = isHost)
+        _uiState.update {
+            it.copy(
+                inRoom = true,
+                roomCode = code,
+                isHost = isHost,
+                members = listOf(
+                    TogetherMember(selfId, _uiState.value.username, isHost),
+                ),
+                lastError = null,
+                error = null,
+            )
+        }
+        roomActionInFlight = false
+        if (isHost) broadcastCurrentState()
+        startPresence()
+    }
+
+    /** Joiner-side existence check when the registry is unreachable:
+     *  probe the channel; if no real member answers, the room does not
+     *  exist — leave again with a "not found" error. The probe is sent
+     *  once connected (a pre-connect probe would be dropped) and the
+     *  countdown starts at send time. */
+    private fun startProbe() {
+        if (_uiState.value.connection is TogetherConnection.Connected) {
+            sendProbeNow()
+        } else {
+            pendingProbe = true
+        }
+    }
+
+    private fun sendProbeNow() {
+        pendingProbe = false
+        engine.sendProbe(TogetherMember(selfId, _uiState.value.username, _uiState.value.isHost))
+        probeJob?.cancel()
+        probeJob = viewModelScope.launch {
+            delay(PROBE_WAIT_MS)
+            val others = _uiState.value.members.filterNot { it.id == selfId }
+            if (_uiState.value.inRoom && others.isEmpty()) {
+                leaveRoom()
+                _uiState.update {
+                    it.copy(error = "Room not found. Check the code and try again.")
+                }
+            }
+        }
+    }
+
+    /** Presence loop: every 15s prove we are still here and drop members
+     *  silent for 30s+ (left, crashed, or lost network). */
+    private fun startPresence() {
+        presenceJob?.cancel()
+        presenceJob = viewModelScope.launch {
+            while (_uiState.value.inRoom) {
+                delay(PRESENCE_INTERVAL_MS)
+                if (!_uiState.value.inRoom) break
+                engine.sendPresence(
+                    TogetherMember(selfId, _uiState.value.username, _uiState.value.isHost),
+                )
+                sweepSilentMembers()
+            }
+        }
+    }
+
+    private fun sweepSilentMembers() {
+        val now = System.currentTimeMillis()
+        val silent = lastSeenMs.filter { (_, seen) -> now - seen > PRESENCE_TIMEOUT_MS }.keys
+        if (silent.isEmpty()) return
+        silent.forEach { lastSeenMs.remove(it) }
+        _uiState.update { state ->
+            state.copy(members = state.members.filterNot { it.id in silent })
+        }
+    }
+
+    fun leaveRoom() {
+        val state = _uiState.value
+        if (state.inRoom) {
+            engine.sendBye(TogetherMember(selfId, state.username, state.isHost))
+        }
+        engine.disconnect()
+        presenceJob?.cancel()
+        probeJob?.cancel()
+        pendingProbe = false
+        lastSeenMs.clear()
+        roomActionInFlight = false
+        _uiState.update {
+            it.copy(
+                inRoom = false,
+                roomCode = "",
+                isHost = false,
+                members = emptyList(),
+                roomTrack = null,
+                roomPlaylist = emptyList(),
+                chatMessages = emptyList(),
+                chatInput = "",
+                lastError = null,
+                error = null,
+            )
+        }
+        playlistUpdatedAtMs = 0L
+        suppressBroadcastUntilMs = 0L
+        pendingPauseJob?.cancel()
+        pendingPauseJob = null
+        pendingRoomState = null
+    }
+
+    /** Room playlist: shared queue keyed by the room code only (no room
+     *  name). Anyone in the room can add the song that is playing, play a
+     *  queued song for everyone, or remove/clear entries. */

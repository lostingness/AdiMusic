+private fun formatPosition(ms: Long): String {
+    val totalSeconds = (ms / 1000).coerceAtLeast(0)
+    return "${totalSeconds / 60}:${(totalSeconds % 60).toString().padStart(2, '0')}"
+}
+
+/**
+ * The Together tab: create or join a listening room, see who is in it,
+ * and watch the room's playback stay in sync. The host's player drives the
+ * room; joiners follow automatically. Nothing here re-implements playback —
+ * it all goes through the shared [MusicPlayer].
+ */
+@Composable
+fun TogetherScreen(
+    viewModel: TogetherViewModel = hiltViewModel(),
+) {
+    val state by viewModel.uiState.collectAsStateWithLifecycle()
+    val clipboard = LocalClipboardManager.current
+
+    if (state.copied) {
+        LaunchedEffect(Unit) {
+            delay(1_600)
+            viewModel.onCopiedConsumed()
+        }
+    }
+
+    Box(
+        modifier = Modifier.fillMaxSize(),
+        contentAlignment = Alignment.TopCenter,
+    ) {
+        Column(
+            Modifier
+                .fillMaxSize()
+                .adaptiveContentWidth(maxWidth = 760.dp)
+                .verticalScroll(rememberScrollState())
+                .padding(bottom = FloatingNavDefaults.ContentBottomPadding + safeDrawingBottomPadding()),
+        ) {
+            ExpressiveHeader(
+                title = stringResource(R.string.nav_together),
+                subtitle = stringResource(R.string.together_subtitle),
+            )
+
+            Column(
+                modifier = Modifier.padding(horizontal = 16.dp),
+                verticalArrangement = Arrangement.spacedBy(16.dp),
+            ) {
+                if (!state.configured) {
+                    Card(
+                        colors = CardDefaults.cardColors(
+                            containerColor = MaterialTheme.colorScheme.errorContainer
+                        ),
+                        modifier = Modifier.fillMaxWidth(),
+                    ) {
+                        Column(Modifier.padding(16.dp)) {
+                            Text(
+                                text = stringResource(R.string.together_not_configured_title),
+                                style = MaterialTheme.typography.titleMedium,
+                                fontWeight = FontWeight.Bold,
+                            )
+                            Spacer(Modifier.height(6.dp))
+                            Text(
+                                text = stringResource(R.string.together_not_configured_text),
+                                style = MaterialTheme.typography.bodyMedium,
+                            )
+                        }
+                    }
+                }
+
+                // ---- connection status ----
+                Card(modifier = Modifier.fillMaxWidth()) {
+                    Column(Modifier.padding(16.dp)) {
+                        Row(verticalAlignment = Alignment.CenterVertically) {
+                            val (dotColor, statusText) = when (val c = state.connection) {
+                                is TogetherConnection.Connected ->
+                                    MaterialTheme.colorScheme.primary to stringResource(R.string.together_status_connected)
+                                is TogetherConnection.Connecting ->
+                                    MaterialTheme.colorScheme.tertiary to stringResource(R.string.together_status_connecting)
+                                is TogetherConnection.Failed ->
+                                    MaterialTheme.colorScheme.error to stringResource(R.string.together_status_failed)
+                                is TogetherConnection.Disconnected ->
+                                    MaterialTheme.colorScheme.outline to stringResource(R.string.together_status_disconnected)
+                            }
+                            Box(
+                                Modifier
+                                    .size(10.dp)
+                                    .clip(CircleShape)
+                                    .background(dotColor)
+                            )
+                            Spacer(Modifier.width(8.dp))
+                            Text(
+                                text = "${stringResource(R.string.together_status_label)}: $statusText",
+                                style = MaterialTheme.typography.titleSmall,
+                                fontWeight = FontWeight.SemiBold,
+                            )
+                        }
+                        if (state.inRoom) {
+                            Spacer(Modifier.height(12.dp))
+                            Row(
+                                verticalAlignment = Alignment.CenterVertically,
+                                horizontalArrangement = Arrangement.SpaceBetween,
+                                modifier = Modifier.fillMaxWidth(),
+                            ) {
+                                Text(
+                                    text = state.roomCode,
+                                    style = MaterialTheme.typography.headlineMedium,
+                                    fontWeight = FontWeight.ExtraBold,
+                                    letterSpacing = androidx.compose.ui.unit.TextUnit.Unspecified,
+                                )
+                                GlassOutlinedButton(onClick = {
+                                    clipboard.setText(AnnotatedString(state.roomCode))
+                                    viewModel.onCopied()
+                                }) {
+                                    Icon(Icons.Filled.ContentCopy, contentDescription = null)
+                                    Spacer(Modifier.width(6.dp))
+                                    Text(stringResource(R.string.together_copy_code))
+                                }
+                            }
+                            if (state.copied) {
+                                Text(
+                                    text = stringResource(R.string.together_copied),
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = MaterialTheme.colorScheme.primary,
+                                )
+                            }
+                            Spacer(Modifier.height(8.dp))
+                            Text(
+                                text = if (state.isHost) {
+                                    stringResource(R.string.together_you_are_host)
+                                } else {
+                                    stringResource(R.string.together_following)
+                                },
+                                style = MaterialTheme.typography.bodyMedium,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                            val lastError = state.lastError
+                            if (lastError != null &&
+                                state.connection !is TogetherConnection.Connected
+                            ) {
+                                Spacer(Modifier.height(6.dp))
+                                Text(
+                                    text = lastError,
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = MaterialTheme.colorScheme.error,
+                                )
+                            }
+                            if (state.members.isNotEmpty()) {
+                                Spacer(Modifier.height(12.dp))
+                                Text(
+                                    text = stringResource(R.string.together_members),
+                                    style = MaterialTheme.typography.titleSmall,
+                                    fontWeight = FontWeight.SemiBold,
+                                )
+                                Spacer(Modifier.height(6.dp))
+                                Row(
+                                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                                    modifier = Modifier.fillMaxWidth(),
+                                ) {
+                                    state.members.forEach { member ->
+                                        Surface(
+                                            shape = RoundedCornerShape(999.dp),
+                                            color = if (member.isHost) {
+                                                MaterialTheme.colorScheme.primaryContainer
+                                            } else {
+                                                MaterialTheme.colorScheme.surfaceContainerHigh
+                                            },
+                                        ) {
+                                            Row(
+                                                verticalAlignment = Alignment.CenterVertically,
+                                                modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp),
+                                            ) {
+                                                Icon(
+                                                    Icons.Filled.Group,
+                                                    contentDescription = null,
+                                                    modifier = Modifier.size(14.dp),
+                                                )
+                                                Spacer(Modifier.width(4.dp))
+                                                Text(
+                                                    text = member.name,
+                                                    style = MaterialTheme.typography.bodySmall,
+                                                    fontWeight = FontWeight.SemiBold,
+                                                )
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                            Spacer(Modifier.height(14.dp))
+                            Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                                GlassOutlinedButton(
+                                    onClick = { viewModel.reconnect() },
+                                    modifier = Modifier.weight(1f),
+                                ) {
+                                    Text(stringResource(R.string.together_reconnect))
+                                }
+                                GlassButton(
+                                    onClick = { viewModel.leaveRoom() },
+                                    modifier = Modifier.weight(1f),
+                                ) {
+                                    Text(stringResource(R.string.together_leave_room))
+                                }
+                            }
+                        }
+                    }
+                }
+
+                // ---- now playing in the room ----
+                if (state.inRoom) {
+                    Card(modifier = Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp)) {
+                            Text(
+                                text = stringResource(R.string.together_now_playing),
+                                style = MaterialTheme.typography.titleSmall,
+                                fontWeight = FontWeight.SemiBold,
+                            )
+                            Spacer(Modifier.height(10.dp))
+                            val track = state.roomTrack
+                            if (track?.trackVideoId == null) {
+                                Text(
+                                    text = stringResource(R.string.together_no_track),
+                                    style = MaterialTheme.typography.bodyMedium,
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                )
+                            } else {
+                                Row(verticalAlignment = Alignment.CenterVertically) {
+                                    ArtworkImage(
+                                        name = track.title ?: "",
+                                        artist = track.artist ?: "",
+                                        embeddedUrl = track.artworkUrl,
+                                        fallbackIcon = Icons.Filled.MusicNote,
+                                        modifier = Modifier
+                                            .size(56.dp)
+                                            .clip(RoundedCornerShape(12.dp)),
+                                    )
+                                    Spacer(Modifier.width(12.dp))
+                                    Column(Modifier.weight(1f)) {
+                                        Text(
+                                            text = track.title ?: "",
+                                            style = MaterialTheme.typography.titleMedium,
+                                            fontWeight = FontWeight.Bold,
+                                            maxLines = 1,
+                                        )
+                                        Text(
+                                            text = track.artist ?: "",
+                                            style = MaterialTheme.typography.bodyMedium,
+                                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                            maxLines = 1,
+                                        )
+                                        if (track.durationMs > 0) {
+                                            Text(
+                                                text = "${formatPosition(track.positionMs)} / ${formatPosition(track.durationMs)}",
+                                                style = MaterialTheme.typography.bodySmall,
+                                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                            )
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }

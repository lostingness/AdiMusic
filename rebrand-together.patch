+import androidx.compose.material3.IconButton
+import androidx.compose.material3.OutlinedButton
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.unit.dp
+import com.lastwave.app.ui.theme.LiquidGlassPreset
+import com.lastwave.app.ui.theme.LocalLiquidGlass
+import com.lastwave.app.ui.theme.LocalLiquidGlassBackdrop
+import com.lastwave.app.ui.theme.isLiquidGlassBackdropSupported
+import com.lastwave.app.ui.theme.liquidGlassChrome
+import com.lastwave.app.ui.theme.liquidGlassContainerColor
+
+/**
+ * Buttons that become Liquid Glass whenever the global Liquid Glass
+ * setting is on (Settings → Appearance → Liquid Glass). With glass off
+ * they are pixel-identical to the plain Material3 buttons, so one toggle
+ * flips every converted button in the app — Home included — at once.
+ *
+ * The glass surface needs a backdrop to sample; MainShell provides the
+ * navigation backdrop to every tab. Where no backdrop exists the chrome
+ * returns the modifier unchanged, so these buttons safely fall back to
+ * their normal look instead of breaking.
+ */
+
+private val GlassButtonShape: Shape = RoundedCornerShape(24.dp)
+
+/**
+ * Glass is on ONLY when the setting is on AND a real backdrop is present
+ * to sample AND the device supports it. A backdrop is provided by the
+ * player and the bottom nav bar — never by plain tab content — so buttons
+ * on ordinary screens stay pixel-identical plain buttons instead of
+ * sampling a backdrop that also captures them (that self-reference
+ * stalled the UI thread and froze the app in v4.2.13).
+ */
+@Composable
+private fun glassEnabled(): Boolean =
+    LocalLiquidGlass.current &&
+        LocalLiquidGlassBackdrop.current != null &&
+        isLiquidGlassBackdropSupported()
+
+@Composable
+fun GlassButton(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    colors: ButtonColors = ButtonDefaults.buttonColors(),
+    shape: Shape? = null,
+    contentPadding: PaddingValues = ButtonDefaults.ContentPadding,
+    content: @Composable RowScope.() -> Unit,
+) {
+    val glass = glassEnabled()
+    val effectiveShape = shape ?: if (glass) GlassButtonShape else ButtonDefaults.shape
+    Button(
+        onClick = onClick,
+        modifier = modifier.liquidGlassChrome(
+            effectiveShape,
+            glass,
+            LiquidGlassPreset.FloatingControls,
+        ),
+        enabled = enabled,
+        colors = if (glass) {
+            colors.copy(containerColor = liquidGlassContainerColor(colors.containerColor))
+        } else {
+            colors
+        },
+        shape = effectiveShape,
+        contentPadding = contentPadding,
+        content = content,
+    )
+}
+
+@Composable
+fun GlassOutlinedButton(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    colors: ButtonColors = ButtonDefaults.outlinedButtonColors(),
+    shape: Shape? = null,
+    contentPadding: PaddingValues = ButtonDefaults.ContentPadding,
+    content: @Composable RowScope.() -> Unit,
+) {
+    val glass = glassEnabled()
+    val effectiveShape = shape ?: if (glass) GlassButtonShape else ButtonDefaults.outlinedShape
+    OutlinedButton(
+        onClick = onClick,
+        modifier = modifier.liquidGlassChrome(
+            effectiveShape,
+            glass,
+            LiquidGlassPreset.FloatingControls,
+        ),
+        enabled = enabled,
+        colors = if (glass) {
+            colors.copy(containerColor = liquidGlassContainerColor(colors.containerColor))
+        } else {
+            colors
+        },
+        shape = effectiveShape,
+        contentPadding = contentPadding,
+        content = content,
+    )
+}
+
+@Composable
+fun GlassTextButton(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    colors: ButtonColors = ButtonDefaults.textButtonColors(),
+    shape: Shape? = null,
+    contentPadding: PaddingValues = ButtonDefaults.ContentPadding,
+    content: @Composable RowScope.() -> Unit,
+) {
+    val glass = glassEnabled()
+    val effectiveShape = shape ?: if (glass) GlassButtonShape else ButtonDefaults.textShape
+    TextButton(
+        onClick = onClick,
+        modifier = modifier.liquidGlassChrome(
+            effectiveShape,
+            glass,
+            LiquidGlassPreset.FloatingControls,
+        ),
+        enabled = enabled,
+        colors = if (glass) {
+            colors.copy(containerColor = liquidGlassContainerColor(colors.containerColor))
+        } else {
+            colors
+        },
+        shape = effectiveShape,
+        contentPadding = contentPadding,
+        content = content,
+    )
+}
+
+@Composable
+fun GlassIconButton(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    content: @Composable () -> Unit,
+) {
+    val glass = glassEnabled()
+    IconButton(
+        onClick = onClick,
+        modifier = modifier.liquidGlassChrome(
+            CircleShape,
+            glass,
+            LiquidGlassPreset.FloatingControls,
+        ),
+        enabled = enabled,
+        content = content,
+    )
+}
